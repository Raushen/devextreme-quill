diff --git a/glob.js b/glob.js
index 2112a957dc501696f443f5620a4e34386a0d1957..7024528445d79b9c34a1e481e3099e24cd1c295a 100644
--- a/glob.js
+++ b/glob.js
@@ -382,7 +382,7 @@ Glob.prototype._processReaddir2 = function (prefix, read, abs, remain, index, in
   // dot is set.  Stuff like @(.foo|.bar) isn't allowed.
   var pn = remain[0]
   var negate = !!this.minimatch.negate
-  var rawGlob = pn._glob
+  var rawGlob = pn.pattern
   var dotOk = this.dot || rawGlob.charAt(0) === '.'
 
   var matchedEntries = []
@@ -391,9 +391,9 @@ Glob.prototype._processReaddir2 = function (prefix, read, abs, remain, index, in
     if (e.charAt(0) !== '.' || dotOk) {
       var m
       if (negate && !prefix) {
-        m = !e.match(pn)
+        m = !pn.test(e)
       } else {
-        m = e.match(pn)
+        m = pn.test(e)
       }
       if (m)
         matchedEntries.push(e)
